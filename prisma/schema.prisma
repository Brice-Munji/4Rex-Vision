// Prisma schema for 4RexVision AI
// PostgreSQL + Auth.js (NextAuth v5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INACTIVE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  PROFESSIONAL
}

enum TradingStyle {
  SCALPING
  DAY_TRADING
  SWING_TRADING
  POSITION_TRADING
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  email         String    @unique
  passwordHash  String?
  avatar        String?
  emailVerified DateTime?

  // Plan & subscription
  plan               Plan               @default(FREE)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)

  // Subscription billing
  billingCycle         BillingCycle?
  subscriptionStart    DateTime?
  currentPeriodEnd     DateTime? // subscription_end
  cancelAtPeriodEnd    Boolean       @default(false)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?

  // Active payment record (provider-agnostic — MTN/Orange/Flutterwave/Card/…)
  paymentProvider      String?
  transactionReference String?

  // Free plan usage logic (prepared, not consumed by AI yet)
  dailyAnalysisCount Int      @default(0)
  analysisCountDate  DateTime @default(now())

  // Onboarding
  onboardingComplete Boolean          @default(false)
  experienceLevel    ExperienceLevel?
  tradingStyle       TradingStyle?
  favoritePairs      String[]         @default([])
  themePreference    ThemePreference  @default(SYSTEM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  transactions        Transaction[]
}

/// Provider-agnostic payment record. One row per checkout attempt; the
/// subscription is only activated after a row reaches SUCCESS (verified
/// server-side). Powers the subscription history + audit trail.
model Transaction {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String        // "flutterwave" | "demo" | future providers
  method            String        // "mtn_momo" | "orange_money" | "flutterwave" | "card"
  reference         String        @unique // our idempotent tx_ref
  providerReference String?       // id returned by the provider
  status            PaymentStatus @default(PENDING)

  // Where the payment was routed (from backend recipient config, never the
  // frontend). Null for rails that settle to a provider merchant account.
  recipient         String?       // receiving account, e.g. MoMo/Orange number
  recipientName     String?       // configured account owner at payment time

  plan              Plan
  amount            Int           // minor units (e.g. cents)
  currency          String        @default("USD")
  description       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Email verification (token hashed before storage)
model VerificationToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Password reset (token hashed before storage)
model PasswordResetToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
