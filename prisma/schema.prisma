// Prisma schema for 4RexVision AI
// PostgreSQL + Auth.js (NextAuth v5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INACTIVE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  PROFESSIONAL
}

enum TradingStyle {
  SCALPING
  DAY_TRADING
  SWING_TRADING
  POSITION_TRADING
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  email         String    @unique
  passwordHash  String?
  avatar        String?
  emailVerified DateTime?

  // Plan & subscription
  plan               Plan               @default(FREE)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)

  // Free plan usage logic (prepared, not consumed by AI yet)
  dailyAnalysisCount Int      @default(0)
  analysisCountDate  DateTime @default(now())

  // Onboarding
  onboardingComplete Boolean          @default(false)
  experienceLevel    ExperienceLevel?
  tradingStyle       TradingStyle?
  favoritePairs      String[]         @default([])
  themePreference    ThemePreference  @default(SYSTEM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Email verification (token hashed before storage)
model VerificationToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Password reset (token hashed before storage)
model PasswordResetToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
