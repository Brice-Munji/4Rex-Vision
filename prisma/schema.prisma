// Prisma schema for 4RexVision AI
// PostgreSQL + Auth.js (NextAuth v5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

enum Role {
  USER
  SUPER_ADMIN
}

/// Where a user's active subscription originated. Payment = paid checkout,
/// ADMIN = granted from the Owner Command Center, PROMO = promotional grant.
enum SubscriptionSource {
  PAYMENT
  ADMIN
  PROMO
}

/// Every privileged action performed from the super-admin dashboard is logged
/// with one of these types for the audit trail.
enum AdminActionType {
  GRANT_PRO
  EXTEND_PRO
  REVOKE_PRO
  RESET_USAGE
  SUSPEND_USER
  UNSUSPEND_USER
  CHANGE_SETTINGS
  SEND_ANNOUNCEMENT
}

enum NotificationType {
  payment_success
  pro_activated
  pro_granted
  pro_revoked
  subscription_expiring
  analysis_saved
  journal_outcome
  system_announcement
  account_security
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INACTIVE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  PROFESSIONAL
}

enum TradingStyle {
  SCALPING
  DAY_TRADING
  SWING_TRADING
  POSITION_TRADING
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  email         String    @unique
  passwordHash  String?
  avatar        String?
  emailVerified DateTime?

  // Access control
  role      Role    @default(USER)
  suspended Boolean @default(false)

  // Plan & subscription
  plan               Plan                @default(FREE)
  subscriptionStatus SubscriptionStatus  @default(INACTIVE)
  subscriptionSource SubscriptionSource?

  // Presence (updated on authenticated activity — powers Active Users Today)
  lastActiveAt DateTime?

  // Subscription billing
  billingCycle         BillingCycle?
  subscriptionStart    DateTime?
  currentPeriodEnd     DateTime? // subscription_end
  cancelAtPeriodEnd    Boolean       @default(false)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?

  // Active payment record (provider-agnostic — MTN/Orange/Flutterwave/Card/…)
  paymentProvider      String?
  transactionReference String?

  // Free plan usage logic (prepared, not consumed by AI yet)
  dailyAnalysisCount Int      @default(0)
  analysisCountDate  DateTime @default(now())

  // Onboarding
  onboardingComplete Boolean          @default(false)
  experienceLevel    ExperienceLevel?
  tradingStyle       TradingStyle?
  favoritePairs      String[]         @default([])
  themePreference    ThemePreference  @default(SYSTEM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  transactions         Transaction[]
  analysisEvents       AnalysisUsage[]
  notifications        Notification[]
  journalEntries       JournalEntry[]
  tradeSetupLifecycles TradeSetupLifecycle[]
  adminActionsMade     AdminAction[]         @relation("AdminActor")
  adminActionsTarget   AdminAction[]         @relation("AdminTarget")

  // Admin dashboard filters/sorts users by these fields.
  @@index([plan])
  @@index([subscriptionStatus])
  @@index([createdAt])
  @@index([lastActiveAt])
}

/// One row per completed chart analysis. Additive usage telemetry (never gates
/// analysis) that powers the Analysis Activity + Analytics dashboards: per-user
/// counts by day, most-analyzed pair, and average confidence.
model AnalysisUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pair       String? // e.g. "AUDUSD" — null when not confidently extracted
  timeframe  String? // e.g. "1H"
  confidence Int? // 0–100
  provider   String? // vision provider used, e.g. "gemini"

  // Diagnostic instrumentation (additive & nullable — never gates analysis).
  // Lets a future cross-device/incident report be verified against real data:
  // was it really the same image, and which provider served each request.
  requestId String? // per-analysis correlation id, also emitted in server logs
  imageHash String? @db.VarChar(64) // SHA-256 of the exact decoded image bytes received

  // History record (powers the user-facing Analysis History). Additive &
  // nullable so older telemetry rows and the admin dashboard are unaffected.
  direction String? // "Bullish" | "Bearish" | "Neutral"
  headline  String? // Rex's one-line verdict
  summary   String? @db.Text // rex_summary — the bias/verdict explanation
  imageUrl  String? @db.Text // chart thumbnail (data URL)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([pair])
  // Analysis History: newest-first per user.
  @@index([userId, createdAt])
  // Diagnostics: find every analysis of the exact same image bytes, regardless
  // of user/device, to confirm or rule out "same screenshot, different result".
  @@index([imageHash])
}

/// Audit trail of every privileged action taken from the super-admin dashboard.
model AdminAction {
  id       String  @id @default(cuid())
  actorId  String
  actor    User    @relation("AdminActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetId String?
  target   User?   @relation("AdminTarget", fields: [targetId], references: [id], onDelete: SetNull)

  type    AdminActionType
  details String? // human-readable summary, e.g. "Granted Pro · 30 days · reason: VIP"

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

/// Provider-agnostic payment record. One row per checkout attempt; the
/// subscription is only activated after a row reaches SUCCESS (verified
/// server-side). Powers the subscription history + audit trail.
model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String // "flutterwave" | "demo" | future providers
  method            String // "mtn_momo" | "orange_money" | "flutterwave" | "card"
  reference         String        @unique // our idempotent tx_ref
  providerReference String? // id returned by the provider
  status            PaymentStatus @default(PENDING)

  // Where the payment was routed (from backend recipient config, never the
  // frontend). Null for rails that settle to a provider merchant account.
  recipient     String? // receiving account, e.g. MoMo/Orange number
  recipientName String? // configured account owner at payment time

  plan        Plan
  amount      Int // minor units (e.g. cents)
  currency    String  @default("USD")
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  // Billing history: newest-first per user.
  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Email verification (token hashed before storage)
model VerificationToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Persistent, per-user notifications powering the bell menu, /notifications
/// page and near real-time (polled) updates.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  actionUrl String? // where clicking the notification takes the user
  metadata  Json? // metadata_json — arbitrary structured context

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  // Notification list: newest-first per user.
  @@index([userId, createdAt])
}

/// Smart Journal — a Rex Pro trade journal. One row per logged trade. Journal
/// data is never deleted; when Pro lapses the journal becomes read-only.
model JournalEntry {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId String? // reference to the originating AnalysisUsage row

  pair       String
  timeframe  String?
  direction  String? // "Bullish" | "Bearish" | "Neutral"
  confidence Int? // 0–100 (imported from the analysis)

  entryPrice Float?
  stopLoss   Float?
  takeProfit Float?
  lotSize    Float?
  riskAmount Float?

  resultType   String @default("OPEN") // OPEN | WIN | LOSS | BREAKEVEN
  resultR      Float? // R multiple
  resultAmount Float?

  traderNote String? @db.Text
  newsRisk   String? // LOW | MEDIUM | HIGH

  createdAt DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  tags     JournalTag[]
  emotions JournalEmotion[]
  outcome  JournalOutcome?

  @@index([userId])
  @@index([userId, resultType])
  @@index([createdAt])
  // Smart Journal timeline: newest-first per user.
  @@index([userId, createdAt])
}

model JournalTag {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  label   String

  @@unique([entryId, label])
  @@index([entryId])
}

model JournalEmotion {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  emotion String

  @@unique([entryId, emotion])
  @@index([entryId])
}

/// "What Happened Next" — the measured outcome of a trade vs its original plan.
model JournalOutcome {
  id      String       @id @default(cuid())
  entryId String       @unique
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  targetReached    Boolean?
  mfe              Float? // maximum favorable excursion (price)
  mae              Float? // maximum adverse excursion (price)
  timeToTargetMins Int?
  accuracyScore    Int? // 0–100
  note             String?  @db.Text

  checkedAt DateTime @default(now())
}

/// Trade Setup Lifecycle (Stage 1) — monitors an ALREADY-GENERATED Rex Trade
/// Setup after the fact. One row per directional setup buildTradeSetup()
/// produced. The original trading levels below are captured once, at
/// creation, and are NEVER overwritten by lifecycle monitoring — only
/// `state` / `lastPrice` / `lastCheckedAt` and the related observations are
/// ever updated afterward. This app has no live/push price feed, so
/// monitoring is strictly upload-driven: a new observation is only recorded
/// when a LATER chart upload of the same pair yields a reliably-read price
/// (see src/lib/rex/lifecycle.ts). Never generates or replaces a setup.
model TradeSetupLifecycle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The originating RexReport's own id (e.g. "rex_eurusd_abc123") — the same
  /// loosely-correlated identifier convention JournalEntry.analysisId already
  /// uses (this app has no FK from a report id to AnalysisUsage.id). One
  /// lifecycle row per generated directional setup.
  setupId String @unique

  pair      String
  timeframe String?
  bias      String // "Bullish" | "Bearish" — ORIGINAL, never changed

  // ── Original trading levels — immutable after creation ───────────────────
  entryZone        String
  invalidationZone String
  target1          String
  target2          String
  entryMid         Float
  invalidationMid  Float
  target1Mid       Float
  target2Mid       Float
  riskReward       String

  generatedAt       DateTime // when buildTradeSetup() produced this setup
  priceAtGeneration Float? // currentPrice at generation, only when reliably available

  // ── Lifecycle state — the only fields monitoring ever updates ─────────────
  state         String    @default("ACTIVE")
  lastPrice     Float?
  lastCheckedAt DateTime?

  observations SetupLifecycleObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, pair])
  @@index([state])
}

/// Append-only price-check history for a tracked setup — one row per
/// monitoring attempt (reliable or not). Deduped per source analysis so
/// re-processing the same upload never creates a duplicate record.
model SetupLifecycleObservation {
  id      String              @id @default(cuid())
  setupId String
  setup   TradeSetupLifecycle @relation(fields: [setupId], references: [id], onDelete: Cascade)

  /// The RexReport.id of the analysis this price reading came from.
  sourceAnalysisId String

  price Float? // null when price wasn't reliably extracted this time (→ UNVERIFIED)
  state String // the lifecycle state determined AT this observation

  observedAt DateTime @default(now())

  @@unique([setupId, sourceAnalysisId])
  @@index([setupId, observedAt])
}

// Password reset (token hashed before storage)
model PasswordResetToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Aggregated Rex sentiment per pair — a lightweight cache that powers the
// Market Intelligence "Rex Sentiment by Pair" card. Derived from AnalysisUsage
// (recent Rex analyses), NOT external APIs. Recomputed whenever an analysis
// completes. One global row per normalized pair (e.g. "EURUSD").
model PairSentiment {
  pair      String   @id // normalized ticker, e.g. "EURUSD"
  bullish   Int      @default(0) // count of Bullish analyses in the window
  bearish   Int      @default(0) // count of Bearish analyses in the window
  neutral   Int      @default(0) // count of Neutral analyses in the window
  samples   Int      @default(0) // total directional analyses in the window
  updatedAt DateTime @updatedAt
}
