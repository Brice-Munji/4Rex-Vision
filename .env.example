# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Super Admin (Owner Command Center) — comma-separated emails allowed to access
# /super-admin. Accounts registered with one of these emails become super admins.
SUPER_ADMIN_EMAILS="you@example.com"

# Google OAuth ("Continue with Google") — create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client, type "Web").
# Add the redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# Leave blank to keep Google sign-in disabled (email/password still works).
# Set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true" once the two secrets are filled in
# so the client shows the button as active.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Email (dev) — verification/reset tokens are logged to the server console in dev
EMAIL_FROM="4RexVision <no-reply@4rexvision.ai>"

# Email delivery — pick ONE (unset = links print to the server console).
# Resend (HTTPS, recommended): create a key at resend.com, verify your domain
# (or use onboarding@resend.dev as EMAIL_FROM for testing to your own inbox).
RESEND_API_KEY=""
# Or generic SMTP (e.g. Gmail app password, Brevo, Mailtrap):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Payments — Rex Pro subscription ($15.99/mo). Provider-agnostic: the registry
# tries live providers first and falls back to a built-in demo provider so the
# checkout flow works before any keys are added. Secret keys are read
# server-side only and are NEVER exposed to the client.
#
# Flutterwave covers the Africa-first rails (MTN MoMo & Orange Money for
# Cameroon), cards, Apple Pay & Google Pay. Set the secret key to go live, and
# the webhook hash to accept payment webhooks at /api/payments/webhook.
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# Payment recipients (destinations) — server-side ONLY, never exposed to the
# client. These are the business's receiving accounts for each mobile-money
# rail. Change a number here (no code / frontend change) to reroute payments.
#   - MTN Mobile Money receiving number
#   - Orange Money receiving number
#   - Account owner shown/recorded as the recipient name (shared across rails)
# Card / hosted Flutterwave rails settle to the provider merchant account, so
# they need no number here.
PAYMENT_MTN_MOMO_NUMBER=""
PAYMENT_ORANGE_MONEY_NUMBER=""
PAYMENT_OWNER_NAME="4RexVision AI"

# Stripe (optional) — leave blank to run billing in simulated mode.
# Secret keys are read server-side only and never exposed to the client.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
STRIPE_PRICE_ELITE_YEARLY=""

# Rex Vision Engine (Anthropic) — server-side only, never exposed to the client.
# Leave blank to run in transparent fallback mode.
ANTHROPIC_API_KEY=""
REX_VISION_MODEL="claude-opus-4-8"

# Multimodal Vision providers (server-side only) — priority: OpenAI -> Gemini -> Anthropic.
# Set at least one to enable real chart recognition. Keys are never exposed to the client.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o"
GEMINI_API_KEY=""

# Vision fallback providers (OpenAI-compatible). Optional — used only if set.
MISTRAL_API_KEY=""      # api.mistral.ai — default model mistral-small-latest
NVIDIA_API_KEY=""       # build.nvidia.com (nvapi-...) — default meta/llama-3.2-11b-vision-instruct
GEMINI_VISION_MODEL="gemini-2.5-flash"

# Finnhub API key (forex news + economic-calendar FALLBACK provider)
FINNHUB_API_KEY=

# Economic calendar provider — "forexfactory" (default, no key needed) or "finnhub".
# Forex Factory uses its own public weekly JSON feed (server-side only). The other
# provider is used automatically as a fallback if the primary is unavailable.
ECONOMIC_CALENDAR_PROVIDER=forexfactory
# Set to 1 to log per-event calendar diagnostics server-side (verbose).
ECONOMIC_CALENDAR_DEBUG=""
