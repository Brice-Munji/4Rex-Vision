# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (dev) — verification/reset tokens are logged to the server console in dev
EMAIL_FROM="4RexVision AI <no-reply@4rexvision.ai>"

# Stripe (optional) — leave blank to run billing in simulated mode.
# Secret keys are read server-side only and never exposed to the client.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
STRIPE_PRICE_ELITE_YEARLY=""

# Rex Vision Engine (Anthropic) — server-side only, never exposed to the client.
# Leave blank to run in transparent fallback mode.
ANTHROPIC_API_KEY=""
REX_VISION_MODEL="claude-opus-4-8"
